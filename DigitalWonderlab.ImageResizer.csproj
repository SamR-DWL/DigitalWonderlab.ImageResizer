<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<!-- NuGet metadata -->
		<IsPackable>true</IsPackable>
		<PackageId>DigitalWonderlab.ImageResizer</PackageId>
		<Version>1.0.0</Version>
		<Authors>Digital Wonderlab</Authors>
		<Company>Digital Wonderlab</Company>
		<Description>Backoffice dashboard that finds oversized images in the media library, resizes them to a maximum width and compresses them. Supports Umbraco 13, 15, 16 and 17.</Description>
		<PackageTags>umbraco;umbraco-cms;media;images;image-resizer;compression;dashboard;umbraco-marketplace</PackageTags>
		<PackageReleaseNotes>1.0.0 - Initial release.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>image-resizer-icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/SamR-DWL/DigitalWonderlab.ImageResizer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SamR-DWL/DigitalWonderlab.ImageResizer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Release builds ship no symbols, so no build-machine .pdb path ends up inside the DLL -->
		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
		<EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>

		<!-- Key for Umbraco App_Plugins packing -->
		<ContentTargetFolders>content</ContentTargetFolders>
		<IncludeBuildOutput>true</IncludeBuildOutput>
	</PropertyGroup>

	<!-- Umbraco 13 only on net8.0: the v13 AngularJS dashboard and API controller do not run on Umbraco 14 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="[15.0.0,17.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[15.0.0,17.0.0)" />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="[15.0.0,17.0.0)" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="[15.0.0,17.0.0)" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0,18.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0,18.0.0)" />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="[17.0.0,18.0.0)" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0,18.0.0)" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- Pack App_Plugins as content -->
	<ItemGroup>
		<Content Include="App_Plugins\DWL.ImageResizer\**" ExcludeFromSingleFile="true">
			<Pack>true</Pack>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- Pack .targets to buildTransitive (Umbraco standard for copy on build) -->
		<None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>

	<!-- README + icon -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="image-resizer-icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- The frontend source lives in "17 Build" and is compiled into App_Plugins by Vite; keep it out of the .NET build -->
	<ItemGroup>
		<Compile Remove="17 Build\**" />
		<Content Remove="17 Build\**" />
		<None Remove="17 Build\**" />
	</ItemGroup>

</Project>
